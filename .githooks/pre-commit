#!/bin/sh
# Lint and format-check staged Python files with the ruff version pinned in uv.lock.
# Enable once per checkout: git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
files=$(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py' | tr '\0' '\n')
[ -n "$files" ] || exit 0
echo "$files" | tr '\n' '\0' | xargs -0 uv run --quiet --frozen --extra dev ruff check -- || {
    echo "pre-commit: ruff check failed; run 'uv run ruff check --fix <files>'" >&2; exit 1; }
echo "$files" | tr '\n' '\0' | xargs -0 uv run --quiet --frozen --extra dev ruff format --check -- || {
    echo "pre-commit: unformatted files; run 'uv run ruff format <files>'" >&2; exit 1; }
